# Copy to .env and fill in. NEVER commit .env — it is git-ignored; keep it that way.
# Direct OpenAI access is for local development only. In team mode, keep this blank on clients;
# OPENAI_API_KEY belongs only in the proxy service's server-side secret settings.
OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint for custom models (for example OpenRouter or an internal
# proxy). Leave blank to use api.openai.com directly.
# OPENAI_BASE_URL=
# Set this to the hosted proxy URL (without the trailing /v1).
LLM_PROXY_URL=
# Supabase project URL and publishable/legacy anon key; safe for local clients.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional for non-interactive CLI use; short-lived and never commit or share it.
KAYA_PROXY_ACCESS_TOKEN=

# MySQL container and application connection settings
KAYA_DB_HOST=127.0.0.1
KAYA_DB_PORT=3306
KAYA_DB_USER=root
KAYA_DB_PASSWORD=capstone
KAYA_DB_ROOT_PASSWORD=capstone

# Host ports. Change these when the defaults are already in use.
KAYA_DB_HOST_PORT=3306
KAYA_STREAMLIT_HOST_PORT=8501
KAYA_CHROMA_HOST_PORT=8000

# OpenAI model settings
OPENAI_OCR_MODEL=gpt-6-luna
OPENAI_CHAT_MODEL=gpt-6-luna
KAYA_OPENAI_MODEL=gpt-6-luna
OPENAI_EMBED_MODEL=text-embedding-3-small
# Extra names shown as suggestions in the chat-model editor; any valid name is accepted.
# GPT-6 variants suggested by default: gpt-6.2-astra, gpt-6.2-sol, gpt-6.1-terra,
# gpt-6.1-sol, gpt-6-astra, gpt-6-sol, gpt-6-luna.
KAYA_CHAT_MODELS=
MONTHLY_BUDGET_USD=50.00

# Model-written SQL is denied unless tables are explicitly listed. No wildcards.
# Include provenance tables so MySQL results can cite original uploaded files.
# uploaded_* tables are the records written by Upload Desk; keep them enabled for
# direct retrieval from both the Upload Desk and Ops Copilot apps.
KAYA_LLM_MYSQL_TABLES=daily_outlet_summary,menu_items,outlet_alias,outlets,pos_transactions,source_document,staff_assignment,staff_roster,staff_shift,supplier,supplier_invoice,supplier_invoice_item,uploaded_invoices,uploaded_invoice_lines,uploaded_invoice_audits,uploaded_outlet_csvs,uploaded_roster_rows
KAYA_LLM_SQLITE_TABLES=supplier_invoice_items
# Limits also apply to existing specialist tools. Add their required tables as needed.
# Use a SELECT-only MySQL account with grants limited to these tables in production.
LOCAL_SQLITE_PATH=data/kaya_ops.db

# Chroma settings
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
CHROMA_COLLECTION=kaya_kopi_knowledge
KAYA_LLM_CHROMA_COLLECTIONS=kaya_kopi_knowledge
# Copy to .env and fill in. NEVER commit .env — it is git-ignored; keep it that way.
# Direct OpenAI access is for local development only. In team mode, keep this blank on clients;
# OPENAI_API_KEY belongs only in the proxy service's server-side secret settings.
OPENAI_API_KEY=
# Set this to the Render service origin (without /v1) after deploying the proxy.
LLM_PROXY_URL=
# Supabase project URL and publishable/legacy anon key; safe for local clients.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional for non-interactive CLI use; short-lived and never commit or share it.
KAYA_PROXY_ACCESS_TOKEN=

# MySQL container and application connection settings
KAYA_DB_HOST=127.0.0.1
KAYA_DB_PORT=3306
KAYA_DB_USER=root
KAYA_DB_PASSWORD=captone
KAYA_DB_ROOT_PASSWORD=captone

# Host ports. Change these when the defaults are already in use.
KAYA_DB_HOST_PORT=3306
KAYA_STREAMLIT_HOST_PORT=8501
KAYA_CHROMA_HOST_PORT=8000

# OpenAI model settings
OPENAI_OCR_MODEL=gpt-4o-mini
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
MONTHLY_BUDGET_USD=50.00

# Chroma settings
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
CHROMA_COLLECTION=kaya_kopi_knowledge